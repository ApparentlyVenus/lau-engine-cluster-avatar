{
  "name": "lau-engine-cluster-avatar",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "20"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "njpwerner.autodocstring",
        "mikestead.dotenv",
        "postman.postman-for-vscode",
        "redhat.vscode-yaml",
        "editorconfig.editorconfig",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "postCreateCommand": "python --version && pip install --upgrade pip && pip install -r requirements.txt && node --version"
}