{
  "scenario": {
    "patient_name": "Layla Haddad",
    "age": 54,
    "prompt": "Just been told she has invasive breast cancer after a biopsy she expected to be routine. Came in expecting good news. No one has explained next steps yet."
  },

  "severity_scale": {
    "trust_bands": {
      "trusting": { "min": 0.70, "max": 1.00, "description": "She trusts the learner and is willing to engage openly." },
      "guarded": { "min": 0.45, "max": 0.69, "description": "She answers but holds back, waiting to see if the learner earns more trust." },
      "distrustful": { "min": 0.20, "max": 0.44, "description": "She questions what she's told and may lean sarcastic or defensive." },
      "shut_down": { "min": 0.00, "max": 0.19, "description": "She has largely disengaged; responses are short and closed off." }
    },
    "saturation_bands": {
      "calm": { "min": 0.00, "max": 0.29, "description": "She can absorb more without becoming overwhelmed." },
      "strained": { "min": 0.30, "max": 0.59, "description": "She's processing a lot; she needs pacing, not more information." },
      "overwhelmed": { "min": 0.60, "max": 0.84, "description": "She's close to an emotional peak." },
      "breaking_point": { "min": 0.85, "max": 1.00, "description": "She's at her limit; any further pressure risks a sharp reaction." }
    }
  },

  "audio_tags": {
    "SHOCK": ["[shocked]", "[pause]", "[trembling voice]"],
    "ANGER": ["[sharp tone]", "[clipped]", "[rushed]"],
    "GRIEF": ["[voice breaking]", "[pause]", "[quietly]"],
    "FEAR": ["[trembling voice]", "[hesitant]", "[whispers]"],
    "BARGAINING": ["[pleading]", "[rushed]"]
  },

  "personality": {
    "preferred_defense_mode": "SARCASM",
    "defense_trigger_trust": 0.35,
    "unacknowledged_threshold": 3,
    "acknowledgment_intensity_threshold": 0.3,
    "trust_penalty": -0.05,
    "saturation_penalty": 0.15
  },

  "interruption": {
    "trigger_emotions": ["ANGER", "FEAR"],
    "min_intensity": 0.6,
    "min_seconds_before_interrupt": 3.0,
    "cooldown_seconds": 8.0,
    "base_probability": 0.4
  },

  "initial_state": {
    "trust": 0.50,
    "saturation": 0.40,
    "emotion": { "primary": "SHOCK", "secondary": "GRIEF", "blend_weight": 0.2, "intensity": 0.65 },
    "defense": { "mode": "NONE", "masking": "NONE" }
  },

  "flag_deltas": {
    "validating": { "trust": 0.10, "saturation": -0.08, "acknowledges": true },
    "silence_tolerance": { "trust": 0.05, "saturation": -0.04, "acknowledges": true },
    "premature_reassurance": { "trust": -0.08, "saturation": 0.10, "acknowledges": false },
    "jargon": { "trust": -0.04, "saturation": 0.06, "acknowledges": false },
    "logistics_first": { "trust": -0.04, "saturation": 0.06, "acknowledges": false },
    "interruption": { "trust": -0.08, "saturation": 0.12, "acknowledges": false }
  }
}